rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Funções de checagem (Os porteiros do sistema)
    function estaLogado() {
      return request.auth != null;
    }
    
    function isAdmGeral() {
      return estaLogado() && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }

    function isArbitro() {
      return estaLogado() && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'arbitro';
    }

    // 2. Regras por Coleção
    
    // Todos podem ler as modalidades, equipes e jogos (porque aparecem no site público)
    match /modalidades/{document=**} {
      allow read: if true;
      allow write: if isAdmGeral();
    }
    
    match /equipes/{document=**} {
      allow read: if true;
      allow write: if isAdmGeral();
    }

    match /colaboradores/{colaborador=**} {
      allow read: if true;
      allow write: if isAdmGeral();
    }
    
    match /jogos/{jogo} {
      allow read: if true; // Público acessa
      // Adm Geral pode tudo. Árbitro só pode se for um update de placar
      allow write: if isAdmGeral() || isArbitro(); 
    }
    
    // Cada usuário pode ler o próprio documento (pra descobrir sua role no login).
    // Só Adm Geral pode ler a lista toda ou escrever.
    match /usuarios/{userId} {
      allow read: if estaLogado() && (isAdmGeral() || request.auth.uid == userId || request.auth.token.email == userId);
      allow write: if isAdmGeral();
    }
  }
}
