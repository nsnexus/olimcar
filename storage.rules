rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Checagem por perfil (firestore.get) depende de leitura cross-service
    // Storage -> Firestore, que pode falhar/atrasar logo após habilitar o
    // Storage num projeto (propagação de permissão interna do Firebase).
    // Por ora simplificado pra exigir só login — mesmo padrão que o Storage
    // usa por padrão quando você clica em "Get Started" no console.
    match /evidencias/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /regulamentos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Qualquer outro caminho fora dos dois de cima: bloqueado por padrão
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
